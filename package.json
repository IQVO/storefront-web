{
  "name": "storefront-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "react-router dev --port 5180",
    "build": "react-router build",
    "start": "node server/index.ts",
    "start:stub": "STOREFRONT_STUB=1 node server/index.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:live": "E2E_BASE_URL=${E2E_BASE_URL:-http://storefront.localhost} E2E_LIVE=1 playwright test e2e/live-purchase.spec.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lhci": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
